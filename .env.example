# NKS Course Assistant — copy to .env and edit.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit it. If you push one by accident, tell your
# instructor straight away — the key gets revoked and reissued and that is the
# end of it. Leaving it there quietly is the only wrong move.
#
# Variable names are frozen. See CONTRACT.md.


# ─── Session secret ──────────────────────────────────────────────────────────
# The app REFUSES TO START while this is the placeholder below. Generate one:
#
#   openssl rand -hex 32
#
SESSION_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32


# ─── Knowledge base ──────────────────────────────────────────────────────────
# local  = the three sample sessions in seed/knowledge-base-sample/, embedded
#          locally with Ollama. No internet, no NKS key. This is the default.
# hosted = the full 44-session corpus from the NKS Retrieval Service. Needs a
#          key from your instructor. Keys hard-expire at the end of your batch.
KB_MODE=local

# Only used when KB_MODE=hosted. Leave blank for local mode.
KB_API_URL=
KB_API_KEY=


# ─── LLM provider ────────────────────────────────────────────────────────────
# Anything OpenAI-compatible. Your credentials stay on your machine and are
# never sent to NKS.
#
# Default is Ollama — free, local, no account, no card:
#
#   ollama pull llama3.1:8b
#   ollama pull nomic-embed-text
#
# Note: from inside Docker, localhost is the container, not your machine.
# Compose maps host.docker.internal for you; on Linux you may need to use
# your host's IP or add --add-host=host.docker.internal:host-gateway.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b

# Faster alternative — Groq's free tier. Uncomment these and comment out the
# three lines above.
#
# Groq (api.groq.com) and Grok (xAI's model) are DIFFERENT PRODUCTS with
# confusingly similar names. You want Groq.
#
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_key_here
# LLM_MODEL=llama-3.1-8b-instant


# ─── Embeddings (KB_MODE=local only) ─────────────────────────────────────────
# Ignored entirely when KB_MODE=hosted — the NKS service embeds server-side.
# Leave EMBEDDING_BASE_URL blank to reuse LLM_BASE_URL. Set it explicitly if
# you generate with a hosted provider but still embed locally with Ollama,
# which is the common case when you switch to Groq.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=nomic-embed-text


# ─── Database ────────────────────────────────────────────────────────────────
# The +asyncpg scheme is not decorative — this codebase is fully async and a
# sync driver here will block the event loop. See "Execution model" in README.
DATABASE_URL=postgresql+asyncpg://nks:nks@postgres:5432/nks


# ─── Runtime ─────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
